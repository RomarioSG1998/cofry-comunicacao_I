            "date": 1765601946695,
            "name": "Commit-0",
            "content": "<div class=\"min-h-screen text-slate-900 overflow-hidden relative font-sans flex items-center justify-center py-10\">\n  \n   <main class=\"relative z-10 w-full max-w-xl px-6\">\n     \n     <div class=\"w-full bg-white/60 backdrop-blur-xl border border-white/40 rounded-3xl shadow-[0_30px_60px_-12px_rgba(0,0,0,0.15)] p-8 md:p-10 animate-fade-in-up\">\n        \n        <div class=\"flex justify-center mb-6\">\n            <div class=\"flex items-center gap-2 cursor-pointer\">\n                <div class=\"w-8 h-8 bg-gradient-to-tr from-emerald-500 to-emerald-700 rounded-lg flex items-center justify-center shadow-lg shadow-emerald-500/30\">\n                    <img src=\"logo.svg\" alt=\"Logo Cofry\" class=\"w-5 h-5 object-contain drop-shadow-sm\">\n                </div>\n                <span class=\"text-xl font-bold tracking-tight text-slate-800\">Cofry</span>\n            </div>\n        </div>\n\n\n        <form [formGroup]=\"signupForm\" (ngSubmit)=\"onSubmit()\" class=\"space-y-4\">\n<!--\n              <div class=\"space-y-1\">\n              <label class=\"text-sm font-bold text-slate-700 ml-1\">\n               Nome Completo</label>\n               <input type=\"text\" formControlName=\"nome\" class=\"w-full pl-4 pr-4 py-3 bg-white/50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-slate-800 placeholder:text-slate-400\" placeholder=\"Seu nome completo\">\n              </div>\n-->\n               <div class=\"space-y-1\">\n                  <label for=\"nome\" class=\"text-sm font-bold text-slate-700 ml-1\">Nome Completo</label>\n                  <input type=\"text\" id=\"nome\" formControlName=\"nome\" class=\"w-full pl-4 pr-4 py-3 bg-white/50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-slate-800 placeholder:text-slate-400\" placeholder=\"Seu nome completo\">\n                  <small *ngIf=\"signupForm.get('nome')?.invalid && signupForm.get('nome')?.touched\" class=\"error-msg\">\n                     Nome é obrigatório (min 3 letras).\n                  </small>\n               </div>\n                     \n\n               \n               <div class=\"space-y-1\">\n                  <label for=\"email\" class=\"text-sm font-bold text-slate-700 ml-1\">Email</label>\n                  <input type=\"text\" id=\"email\" formControlName=\"email\" class=\"w-full pl-4 pr-4 py-3 bg-white/50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-slate-800 placeholder:text-slate-400\" placeholder=\"seu@email.com\">\n                  <small *ngIf=\"signupForm.get('email')?.invalid && signupForm.get('email')?.touched\" class=\"error-msg\">\n                    email burro\n                  </small>\n               </div>\n\n\n               <div class=\"space-y-1\">\n                  <label for=\"dateOfBirth\" class=\"text-sm font-bold text-slate-700 ml-1\">ze</label>\n                  <input \n                      type=\"date\"\n                       formControlName=\"dateOfBirth\"\n                       class=\"w-full pl-11 pr-4 py-3 bg-white/50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-slate-800 placeholder:text-slate-400\">\n               <small *ngIf=\"signupForm.get('dateOfBirth')?.invalid && signupForm.get('dateOfBirth')?.touched\" class=\"error-msg\">\n                    Data de nascimento é obrigatória.\n                  </small>\n\n               </div>\n\n\n                 \n              \n\n\n         \n              <div class=\"grid grid-cols-2 gap-4\">\n                  <div class=\"space-y-1\">\n                  <label for=\"cpf\" class=\"text-sm font-bold text-slate-700 ml-1\">CPF</label>\n                  <input type=\"text\" formControlName=\"cpf\" class=\"w-full pl-4 pr-4 py-3 bg-white/50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-slate-800 placeholder:text-slate-400\" placeholder=\"000.000.000-00\">\n                  <small *ngIf=\"signupForm.get('cpf')?.invalid && signupForm.get('cpf')?.touched\" class=\"error-msg\">\n                    CPF inválido\n                  </small>\n               </div>\n               <div class=\"space-y-1\">\n                  <label for=\"password\" class=\"text-sm font-bold text-slate-700 ml-1\">Senha</label>\n                  <input type=\"password\" formControlName=\"password\" class=\"w-full pl-4 pr-4 py-3 bg-white/50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-slate-800 placeholder:text-slate-400\" placeholder=\"********\">\n                  <small *ngIf=\"signupForm.get('password')?.invalid && signupForm.get('password')?.touched\" class=\"error-msg\">\n                    senha o bobo alegre\n                  </small>\n               </div>\n              </div>\n           \n\n            <button\n            type=\"submit\"\n            class=\"flex-1 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/20 transition-all transform hover:-translate-y-1 flex justify-center items-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed\">\n            Criar Conta \n            </button>\n        </form>\n          \n       \n        <div class=\"mt-6 text-center\">\n           <p class=\"text-slate-600 text-sm\">\n              Já tem uma conta? \n              <button class=\"text-emerald-600 font-bold hover:underline ml-1 cursor-pointer\">Fazer Login</button>\n           </p>\n        </div>\n      </div> </main>\n</div>"
        }
    ]
}