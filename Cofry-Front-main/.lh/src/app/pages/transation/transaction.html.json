            "content": "<div *ngIf=\"transaction as t\" class=\"flex justify-between items-center p-4 border-b border-gray-100 last:border-b-0 hover:bg-gray-50 transition duration-150 ease-in-out cursor-pointer\">\r\n  <div class=\"flex items-center space-x-4\">\r\n    <div class=\"w-10 h-10 rounded-full flex items-center justify-center\"\r\n      [ngClass]=\"{\r\n        'bg-green-100 text-green-700': (t.amount ?? 0) > 0,\r\n        'bg-red-100 text-red-700': (t.amount ?? 0) < 0\r\n      }\">\r\n      <span *ngIf=\"(t.amount ?? 0) > 0\">↑</span>\r\n      <span *ngIf=\"(t.amount ?? 0) < 0\">↓</span>\r\n    </div>\r\n\r\n    <div>\r\n      <p class=\"font-semibold text-gray-800 truncate max-w-xs\">{{ t.description }}</p>\r\n      <p class=\"text-xs text-gray-500\">\r\n        {{ t.transactionDate | date: 'shortDate' }} •\r\n        <span [ngClass]=\"{\r\n          'text-green-600 font-medium': (t.amount ?? 0) > 0,\r\n          'text-red-600 font-medium': (t.amount ?? 0) < 0\r\n        }\">\r\n          {{ (t.amount ?? 0) > 0 ? 'Crédito' : 'Débito' }}\r\n        </span>\r\n      </p>\r\n    </div>\r\n  </div>\r\n\r\n  <div [ngClass]=\"{\r\n        'text-green-600': (t.amount ?? 0) > 0,\r\n        'text-red-600': (t.amount ?? 0) < 0\r\n      }\" class=\"font-extrabold text-lg flex-shrink-0 ml-4\">\r\n    {{ (t.amount ?? 0) | currency: 'BRL' }}\r\n  </div>\r\n</div>\r\n"
