            "date": 1765614426932,
            "name": "Commit-0",
            "content": "<div class=\"container mx-auto p-4\">\r\n  <h1 class=\"text-3xl font-bold text-gray-900 mb-6\">Histórico de Transações</h1>\r\n\r\n  <div *ngIf=\"isLoading\" class=\"text-center p-8 text-gray-500\">\r\n    <p>Carregando transações...</p>\r\n  </div>\r\n\r\n  <div *ngIf=\"errorMessage\" class=\"bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4\" role=\"alert\">\r\n    <p>{{ errorMessage }}</p>\r\n  </div>\r\n\r\n  <div \r\n    *ngIf=\"!isLoading && transactions.length > 0\" \r\n    class=\"bg-white shadow-xl rounded-lg divide-y divide-gray-100\"\r\n  >\r\n    <app-transaction-card \r\n      *ngFor=\"let t of transactions\" \r\n      [transaction]=\"t\"\r\n    ></app-transaction-card>\r\n  </div>\r\n\r\n  <div *ngIf=\"!isLoading && transactions.length === 0 && !errorMessage\" class=\"text-center p-12 text-gray-500 border border-dashed rounded-lg mt-6\">\r\n    <p class=\"font-semibold\">Nenhuma transação encontrada.</p>\r\n  </div>\r\n</div>"
        }
    ]
